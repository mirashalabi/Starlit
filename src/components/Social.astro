---
// Instagram and TikTok as real icon buttons (handles from the original site's footer).
import { site } from '~/config/site';
interface Props { variant?: 'icons' | 'big'; class?: string }
const { variant = 'icons', class: cls } = Astro.props;
const svg: Record<string, string> = {
  Instagram: '<rect x="3" y="3" width="18" height="18" rx="5.2" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="17.4" cy="6.6" r="1.2" fill="currentColor"/>',
  TikTok: '<path fill="currentColor" d="M16.6 3c.3 2.4 1.7 3.9 4 4.1v2.8c-1.5.1-2.8-.4-4-1.2v5.6c0 3.6-2.6 6.2-6.1 6.2-3.3 0-6-2.6-6-5.9 0-3.6 3.1-6.3 6.8-5.8v2.9c-.4-.1-.7-.2-1.1-.2-1.7 0-3 1.3-3 3 0 1.6 1.3 2.9 2.9 2.9 1.8 0 3-1.3 3-3.3V3h3.5z"/>',
};
---
<ul class:list={['social', `social--${variant}`, cls]}>
  {site.social.map((s) => (
    <li>
      <a href={s.href} target="_blank" rel="noopener" aria-label={`${site.shortName} on ${s.label} (${s.handle})`}>
        <svg viewBox="0 0 24 24" aria-hidden="true" set:html={svg[s.label]} />
        {variant === 'big' && <span class="social__text"><span class="social__net">{s.label}</span><span class="social__handle">{s.handle}</span></span>}
      </a>
    </li>
  ))}
</ul>
