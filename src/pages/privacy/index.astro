---
import Base from '~/layouts/Base.astro';
import Crumbs from '~/components/Crumbs.astro';
import { site } from '~/config/site';
const crumbs = [{ name: 'Privacy', path: '/privacy/' }];
---
<Base title="Privacy Policy | Starlit Events & Photography" description="How Starlit Events & Photography handles the details you send through this website." crumbs={crumbs} solidHeader cta={false}>
  <section class="page-head on-light">
    <div class="wrap">
      <Crumbs items={crumbs} />
      <h1 class="display-l">Privacy <em>Policy</em></h1>
    </div>
  </section>
  <section class="section on-light" style="padding-top:clamp(32px,4vw,56px)">
    <div class="wrap prose">
      <p>This page explains what {site.name} (“Starlit”) does with the information you send through this website.</p>
      <h2>What we collect</h2>
      <p>When you send an inquiry we receive the details you enter: your name, email address, phone number, inquiry type, event date, message and any rental items you added. We also receive the page you sent it from.</p>
      <p>The rental items you add are kept in your own browser until you send the inquiry. They are not sent to us before then.</p>
      <h2>How we use it</h2>
      <p>We use your details only to answer your inquiry, prepare a quote and arrange your event, rental or photography session. We do not sell or rent your information.</p>
      <h2>Analytics and cookies</h2>
      <p>This website does not use advertising or analytics cookies.</p>
      <h2>Your choices</h2>
      <p>To see, correct or delete the information we hold about you, email <a href={`mailto:${site.email}`}>{site.email}</a> or call <a href={site.phoneHref}>{site.phone}</a>.</p>
    </div>
  </section>
</Base>
