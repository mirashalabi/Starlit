google.visualization.Query.setResponse({"version":"0.6","reqId":"0","status":"ok","sig":"2073504112","table":{"cols":[{"id":"A","label":"Service","type":"string"},{"id":"B","label":"Description","type":"string"},{"id":"C","label":"Tagline","type":"string"},{"id":"D","label":"Session Duration (hr)","type":"number","pattern":"General"},{"id":"E","label":"Variations","type":"string"},{"id":"F","label":"Price","type":"number","pattern":"\u0022$\u0022#,##0"},{"id":"G","label":"Photo Name","type":"string"},{"id":"H","label":"Extra Inquiries","type":"string"}],"rows":[{"c":[{"v":"Event Photography"},{"v":"Capture every special moment at your event with our professional event photography services at Starlit. Our experienced photographers will ensure that every moment, from the candid to the staged, is beautifully captured to create lasting memories of your special occasion. Let us help you make your event truly unforgettable."},{"v":"Event digital & film photography"},{"v":4.0,"f":"4"},{"v":"Digital Photography"},{"v":800.0,"f":"$800"},{"v":"Event_Photography"},{"v":null}]},{"c":[null,null,null,null,{"v":"Film Photography"},{"v":400.0,"f":"$400"},null,{"v":null}]},{"c":[null,null,null,null,{"v":"Both Digital and Film"},{"v":600.0,"f":"$600"},null,{"v":null}]},{"c":[{"v":"Professional Headshots"},{"v":"Capture professional headshots with Starlit for the perfect image for your next event, portfolio, or professional profile. Our expert photographers know how to highlight your best features and make you feel confident in front of the camera, ensuring you get the perfect shots every time."},{"v":"Outline your professionalism"},{"v":1.0,"f":"1"},null,{"v":75.0,"f":"$75"},{"v":"Professional_Headshots"},{"v":null}]},{"c":[{"v":"Product Photography"},{"v":"Let Starlit capture your products in the best light with our professional product photography service. Our skilled photographers will showcase your products in the most appealing way, ensuring that they stand out and make a lastin